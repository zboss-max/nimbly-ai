# 复制本文件为 .env（同目录），填入真实值。.env 不会入库。
# 数据库连接串格式：mysql+pymysql://用户名:密码@主机:端口/库名?charset=utf8mb4
SQLALCHEMY_DATABASE_URI=mysql+pymysql://user:password@localhost:3306/nimbly_ai?charset=utf8mb4

# JWT 签名密钥，生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 换了这个值之后，所有已签发的 token 立即失效，需要重新登录
JWT_SECRET_KEY=change-me-generate-with-secrets-token_urlsafe
